<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:label="MagicNumber"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MagicNumber">

        <activity android:name=".activity.SettingsActivity" android:exported="false" />
        <activity android:name=".activity.HistoryActivity" android:exported="false" />

        <activity android:name=".activity.LuckyResultsActivity" android:exported="false" />
        <activity android:name=".activity.LuckyAnimationActivity" android:exported="false" />
        <activity android:name=".activity.LuckyBiometricActivity" android:exported="false" />

        <activity android:name=".activity.CombinationConfigActivity" android:exported="false" />
        <activity android:name=".activity.ManualNumbersActivity" android:exported="false" />
        <activity android:name=".activity.GeneratedNumbersActivity" android:exported="false" />
        <activity android:name=".activity.GenerateNumbersActivity" android:exported="false" />
        <activity android:name=".activity.NumberSourceActivity" android:exported="false" />
        <activity android:name=".activity.HomeActivity" android:exported="false" />
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
